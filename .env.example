# Copy to .env.local for local development only. Never commit a populated env file.
# Vite exposes every VITE_* value to browsers: API keys and secrets must never use that prefix.
# Production deployments fail before activation when the selected provider key,
# ADMIN_PASSWORD, ADMIN_SESSION_SECRET, AI_SOURCE_SIGNING_SECRET, or an HTTPS SITE_URL is missing/placeholder.

NODE_ENV="development"
API_SERVER_HOST="127.0.0.1"
API_SERVER_PORT="3001"
# Only set true when an explicitly configured firewall/reverse proxy requires a public bind.
ALLOW_PUBLIC_API_BIND="false"
APP_URL="http://127.0.0.1:5173"
SITE_URL="http://127.0.0.1:5173"

# Select one server-side AI provider. Fill only in .env.local or the server secret store.
AI_PROVIDER="grok"
XAI_API_KEY=""
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimaxi.com/v1"

# Optional demand-sensing provider settings.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=""
X_SEARCH_MODE="auto"

# Required in production. Generate distinct random values; do not use these empty defaults.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
# Signs research-source proofs and final report grants; use a distinct random value.
AI_SOURCE_SIGNING_SECRET=""

# Keep production data outside atomic release directories, for example:
# /var/www/compare-ai/shared/compareai-analytics.db
ANALYTICS_DB_PATH="server/compareai-analytics.db"

# Webhook settings belong in /etc/compare-ai/webhook.env, not the app env file.
# The webhook process exits immediately if WEBHOOK_SECRET or WEBHOOK_REPOSITORY is absent/placeholder.
# WEBHOOK_SECRET=""                 # openssl rand -hex 32
# WEBHOOK_REPOSITORY="owner/repository"
# WEBHOOK_BRANCH="main"
# WEBHOOK_HOST="127.0.0.1"
# WEBHOOK_PORT="9000"
# WEBHOOK_MAX_PAYLOAD_BYTES="1048576"
# DEPLOY_TIMEOUT_MS="900000"
