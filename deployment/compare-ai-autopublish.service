[Unit]
Description=CompareAI auto-publisher (batch report generation)
After=network-online.target compare-ai-api.service
Wants=compare-ai-api.service

[Service]
Type=oneshot
WorkingDirectory=/var/www/compare-ai
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx tsx server/jobs/autoPublish.ts
TimeoutStartSec=7200
Nice=10

[Install]
WantedBy=multi-user.target
